    },
    "Shaw 1993（RTOG SRS QA guidelines）" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shaw 1993 (RTOG SRS QA guidelines)"
          }
        }
