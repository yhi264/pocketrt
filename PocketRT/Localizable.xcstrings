    "放射線治療計画ガイドライン 2024 年版 中枢神経「SRS：辺縁線量 12〜13 Gy で行われることが多く」" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JASTRO Radiotherapy Planning Guidelines 2024, Central Nervous System. Quoted in the original Japanese (no official English edition; the rendering below is editorial): 「SRS：辺縁線量 12〜13 Gy で行われることが多く」— “For SRS a marginal dose of 12–13 Gy is most often used.”"
          }
        }
      }
    },
    "放射線治療計画ガイドライン 2024 年版 泌尿器「IMRT の場合には 74〜78 Gy が用いられることが多い」。分割数は同記載からは確認できない（1 回 2 Gy とすれば 39 回）" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JASTRO Radiotherapy Planning Guidelines 2024, Genitourinary. Quoted in the original Japanese (no official English edition; the rendering below is editorial): 「IMRT の場合には 74〜78 Gy が用いられることが多い」— “With IMRT, 74–78 Gy is most often used.” The number of fractions cannot be confirmed from this statement (39 fractions if 2 Gy per fraction is assumed)."
          }
        }
      }
    },
    "放射線治療計画ガイドライン 2024 年版 緩和「全脳照射では、30 Gy/10 回/2 週が標準的である」" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JASTRO Radiotherapy Planning Guidelines 2024, Palliative Care. Quoted in the original Japanese (no official English edition; the rendering below is editorial): 「全脳照射では、30 Gy/10 回/2 週が標準的である」— “For whole-brain radiotherapy, 30 Gy in 10 fractions over 2 weeks is standard.”"
          }
        }
      }
    },
    "放射線治療計画ガイドライン 2024 年版 胸部「通常分割照射（50 Gy/25 回/35 日）」" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JASTRO Radiotherapy Planning Guidelines 2024, Thorax. Quoted in the original Japanese (no official English edition; the rendering below is editorial): 「通常分割照射（50 Gy/25 回/35 日）」— “conventionally fractionated irradiation (50 Gy in 25 fractions over 35 days).”"
          }
        }
      }
    },
    "放射線治療計画ガイドライン 2024 年版 頭頸部「70 Gy/35 回/7 週の通常分割照射が標準分割照射法である」" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JASTRO Radiotherapy Planning Guidelines 2024, Head and Neck. Quoted in the original Japanese (no official English edition; the rendering below is editorial): 「70 Gy/35 回/7 週の通常分割照射が標準分割照射法である」— “Conventionally fractionated irradiation of 70 Gy in 35 fractions over 7 weeks is the standard fractionation.”"
          }
        }
      }
    },
