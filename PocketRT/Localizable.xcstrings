          }
        }
      }
    },
    "許容値 MDPD: %.1f 以下で none、%.1f 超 %.1f 未満で minor、%.1f 以上で major" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MDPD tolerance: none at %1$.1f or below, minor above %2$.1f and below %3$.1f, major at %4$.1f or above"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "許容値 MDPD: %1$.1f 以下で none、%2$.1f 超 %3$.1f 未満で minor、%4$.1f 以上で major"
          }
        }
      }
    },
    "許容値 PITV: %.1f 以上 %.1f 未満で none、%.1f 超 %.1f 未満または %.1f 以上 %.1f 未満で minor、%.1f 以下または %.1f 以上で major" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PITV tolerance: none from %1$.1f up to but not including %2$.1f, minor above %3$.1f and below %4$.1f or from %5$.1f up to but not including %6$.1f, major at %7$.1f or below or at %8$.1f or above"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "許容値 PITV: %1$.1f 以上 %2$.1f 未満で none、%3$.1f 超 %4$.1f 未満または %5$.1f 以上 %6$.1f 未満で minor、%7$.1f 以下または %8$.1f 以上で major"
          }
        }
      }
    },
