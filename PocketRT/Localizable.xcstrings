      }
    },
    "PocketRT プライバシーポリシー" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PocketRT Privacy Policy"
          }
        }
      }
    },
    "R50% = V50%Rx / TV\nGI(Paddick) = V50%Rx / PIV\nD2cm = (PTV から 2 cm 外側の最大線量) / Rx × 100" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "R50% = V50%Rx / TV\nGI(Paddick) = V50%Rx / PIV\nD2cm = (max dose 2 cm outside the PTV) / Rx × 100"
          }
        }
      }
    },
    "R50% の定義は原典間で食い違っています。RTOG 0813 は「処方線量の 50% の等線量体積 ÷ PTV 体積」と定義していますが、RTOG 0915 は同じ箇所を「34 Gy または 12 Gy の等線量体積」と記しており、これは第 1 群の全線量と第 2 群の 1 回線量にあたり、いずれも処方線量の 50% になりません。本アプリは、両プロトコルの表の見出し（Ratio of 50% Prescription Isodose Volume to the PTV Volume）と RTOG 0813 の記述に従い、「処方線量の 50% の等線量体積 ÷ PTV 体積」として計算します。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The source protocols define R50% differently. RTOG 0813 defines it as “the isodose volume of 50% of the prescription dose ÷ PTV volume,” whereas RTOG 0915 describes the same quantity as “the isodose volume of 34 Gy or 12 Gy” — the total dose of arm 1 and the fraction dose of arm 2, neither of which is 50% of the prescription dose. This app follows the table heading used in both protocols (Ratio of 50% Prescription Isodose Volume to the PTV Volume) and the wording of RTOG 0813, and computes R50% as the isodose volume of 50% of the prescription dose ÷ PTV volume."
          }
        }
      }
    },
    "RTOG 0813" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RTOG 0813"
          }
        }
      }
    },
    "RTOG 0813（中心型肺）" : {
      "localizations" : {
        "en" : {
