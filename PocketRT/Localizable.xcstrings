    "BED" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BED"
          }
        }
      }
    },
    "BED = n · d · (1 + d / (α/β))" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BED = n · d · (1 + d / (α/β))"
          }
        }
      }
    },
    "BED を「1 回 2 Gy の通常分割で照射した場合の総線量」に換算した値です。\n臨床で慣用される線量感覚に近いため、BED より解釈しやすい場面があります。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BED expressed as the total dose that would be delivered with conventional 2 Gy fractions.\nBecause it is closer to the dose scale used in daily practice, it is often easier to interpret than BED."
          }
        }
      }
    },
    "BED（生物学的等価線量）" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BED (biologically effective dose)"
